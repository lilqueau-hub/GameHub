{% extends 'base.html.twig' %}
{% block title %}Toutes les Soirées{% endblock %}

{% block body %}

<h1>Soirées</h1>

{% if soireejeu is empty %}
    <p>Aucune soirée trouvée</p>
{% else %}
    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>Titre</th>
            </tr>
        </thead>
        <thbody>
            {% for soireejeu in soireejeux %}
                <tr>
                    <td>{{ soireejeu.titre }}</td>
                    <td>{{ soireejeu.jeu_associe }}</td>
                    <td>{{ soireejeu.date_soiree }}</td>
                    <td>{{ soireejeu.nombre_joueurs }}</td>
                </tr>
            {% endfor %}
        </thbody>
    </table>
{% endif %}
{% endblock %}