{% extends 'base.html.twig' %}

{% block body %}
<h2>Ajouter une soirée jeu</h2>

<form>
    {{ form_row(form.jeu_associe) }}
    {{ form_row(form.date_soiree) }}
    {{ form_row(form.nombre_joueurs) }}
    {{ form_row(form.age_minimum) }}
    <button type="submit">Ajouter une soirée</button>
</form>
{% endblock %}