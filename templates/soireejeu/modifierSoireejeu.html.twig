{% extends 'base.html.twig' %}

{% block body %}
<h2>Modifier la soirée jeu</h2>

{{ form_start(form) }}
    {{ form_row(form.jeu_associe) }}
    {{ form_row(form.date_soiree) }}
    {{ form_row(form.nombre_joueurs) }}
    {{ form_row(form.age_minimum) }}
    <button type="submit">Enregistrer les modifications</button>
{{ form_end(form) }}

{% endblock %}