{% extends 'base.html.twig' %}

{% block title %}Recherche{% endblock %}

{% block body %}
    <a href ="{{ path('app_jeu')}}">Consulter le catalogue</a>

    <form action="{{ path('jeu_recherche') }}" method="GET">
        <input type="text" name="titre" placeholder="Saisir un titre" value ="{{ titre }}">
        <button type="submit">Rechercher</button>
    </form>

    {% if jeux is empty %}
        <p>Aucun jeu trouvé</p>
    {% else %}
        {% for jeu in jeux %}
            <h3>Titre : {{ jeu.titre }} </h3>
            <ul>
                <li>{{ jeu.description }}</li>
                <li>{{ jeu.duree_moyenne }}</li>
                <li>{{ jeu.age_minimum }}</li>
                <li>{{ jeu.nombre_joueurs }}</li>
            </ul>
        {% endfor %}
    {% endif %}
{% endblock %}