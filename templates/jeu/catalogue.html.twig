{% extends 'base.html.twig' %}

{% block title %}Catalogue de jeux vidéos{% endblock %}

{% block body %}
    <h2>Catalogue de jeux</h2>
    {% if jeux is empty %}
        <p>Aucun jeu trouvé</p>
    {% else %}
        {% for jeu in jeux %}
            <h3>Titre : {{ jeu.titre }} </h3>
            <ul>
                <li>{{ jeu.description }}</li>
                <li>{{ jeu.duree_moyenne }}</li>
                <li>{{ jeu.age_minimum }}</li>
                <li>{{ jeu.nombre_joueurs }}</li>
            </ul>
        {% endfor %}
    {% endif %}
    {% else %}
        <p>{{ catalogue.nom }}</p>
    {% endif %}
{% endblock %}