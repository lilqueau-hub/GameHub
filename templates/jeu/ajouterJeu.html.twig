{% extends 'base.html.twig' %}

{% block body %}
<h2>Ajouter un jeu</h2>

{{ form_start(form) }}
    {{ form_row(form.titre) }}
    {{ form_row(form.jeu_categorie) }}
    {{ form_row(form.description) }}
    {{ form_row(form.duree_moyenne) }}
    {{ form_row(form.nombre_joueurs) }}
    {{ form_row(form.age_minimum) }}
    <button type="submit">Enregistrer</button>
{{ form_end(form) }}

{% endblock %}