{% extends 'base.html.twig' %}
{% block title %}Tous les jeux{% endblock %}

{% block body %}

<h1>Catalogue de jeux</h1>

{% if jeux is empty %}
    <p>Aucun jeu trouvé</p>
{% else %}
    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>Titre</th>
            </tr>
        </thead>
        <thbody>
            {% for jeu in jeux %}
                <tr>
                    <td>{{ jeu.titre }}</td>
                    <td>{{ jeu.description }}</td>
                    <td>{{ jeu.duree_moyenne }}</td>
                    <td>{{ jeu.age_minimum }}</td>
                    <td>{{ jeu.nombre_joueurs }}</td>
                    <td>{{ jeu.categorie }}</td>
                </tr>
            {% endfor %}
        </thbody>
    </table>
{% endif %}
{% endblock %}